<Window x:Class="BFCrewSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BFCrewSync" Height="720" Width="480"
        MinHeight="620" MinWidth="440"
        Background="{StaticResource BgDark}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- header / clock / perf -->
            <RowDefinition Height="Auto"/>   <!-- countdown -->
            <RowDefinition Height="Auto"/>   <!-- sync engine -->
            <RowDefinition Height="Auto"/>   <!-- optimizer -->
            <RowDefinition Height="*"/>      <!-- log -->
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="BFCrewSync" FontSize="16" FontWeight="Bold"/>
                    <TextBlock x:Name="IstClockText" Text="00:00:00.000" FontFamily="Consolas"
                               FontSize="26" FontWeight="Bold" Foreground="{StaticResource Accent}" Margin="0,2,0,0"/>
                    <TextBlock Text="IST (UTC+5:30)" Style="{StaticResource Label}" Margin="0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <Border Background="#11141A" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CPU " Style="{StaticResource Label}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="CpuText" Text="0%" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#11141A" CornerRadius="6" Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="RAM " Style="{StaticResource Label}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RamText" Text="0%" FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Countdown ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,10"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="COUNTDOWN TO TARGET" Style="{StaticResource Label}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CountdownText" Text="--:--:--.---" FontFamily="Consolas" FontSize="34"
                           FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TargetInfoText" Text="No target set" Style="{StaticResource Label}"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Sync Engine ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SYNC ENGINE" Style="{StaticResource SectionHeader}"/>

                <TextBlock Text="Root target directory" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RootDirBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Browse…" Click="BrowseRoot_Click"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Owner" Style="{StaticResource Label}"/>
                        <TextBox x:Name="OwnerBox"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Crew owner" Style="{StaticResource Label}"/>
                        <TextBox x:Name="CrewOwnerBox"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Crew ID" Style="{StaticResource Label}"/>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CrewIdBox" Grid.Column="0"/>
                    <Button x:Name="ScanCrewIdButton" Grid.Column="2" Content="Scan Crew ID" Click="ScanCrewId_Click"/>
                </Grid>
                <TextBlock x:Name="ScanStatusText" Text="" Style="{StaticResource Label}" Margin="0,0,0,8"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="120"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Target IST time (HH:mm:ss)" Style="{StaticResource Label}"/>
                        <TextBox x:Name="TargetTimeBox" Text="00:00:00"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="or +N minutes" Style="{StaticResource Label}"/>
                        <TextBox x:Name="OffsetMinutesBox" Text=""/>
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="LegacyFallbackCheck" Content="Also write legacy string format (crewId@@targetEpoch)"
                          Margin="0,2,0,10"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="SET SYNC" Style="{StaticResource PrimaryButton}" Click="SetSync_Click"/>
                    <Button Grid.Column="2" Content="REGISTER" Click="Register_Click"/>
                    <Button Grid.Column="4" Content="CANCEL" Style="{StaticResource DangerButton}" Click="Cancel_Click"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Optimizer ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="SYSTEM OPTIMIZER" Style="{StaticResource SectionHeader}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="LowerPriorityCheck" Grid.Column="0" Content="Lower Roblox background priority when trimming"
                              IsChecked="True" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Optimize Now" Style="{StaticResource PrimaryButton}" Click="OptimizeNow_Click"/>
                </Grid>
                <TextBlock x:Name="OptimizerResultText" Text="Not run yet." Style="{StaticResource Label}" Margin="0,8,0,0"/>
            </StackPanel>
        </Border>

        <!-- ===== Activity Log ===== -->
        <Border Grid.Row="4" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Style="{StaticResource SectionHeader}" Margin="4,0,0,6"/>
                <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                         FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
